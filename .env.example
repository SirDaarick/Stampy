# --- Base de Datos PostgreSQL ---
POSTGRES_USER=stampy_user
POSTGRES_PASSWORD=stampy_secret_pass
POSTGRES_DB=stampy_db
DATABASE_URL=postgresql+asyncpg://stampy_user:stampy_secret_pass@localhost:5432/stampy_db
SYNC_DATABASE_URL=postgresql://stampy_user:stampy_secret_pass@localhost:5432/stampy_db

# --- Redis & Message Broker ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 Object Storage ---
MINIO_ROOT_USER=stampy_minio_admin
MINIO_ROOT_PASSWORD=stampy_minio_secret
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=stampy-receipts
S3_ACCESS_KEY=stampy_minio_admin
S3_SECRET_KEY=stampy_minio_secret

# --- Telegram Bot & Auth ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# --- Seguridad JWT ---
JWT_SECRET=super_secret_jwt_key_stampy_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- LLM & Vision Providers ---
GEMINI_API_KEY=your_gemini_api_key_here
